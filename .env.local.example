# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- control-panel (Entitlements API) ---
# Server-only: never prefix these with NEXT_PUBLIC_, the API key must never
# reach the browser. See control-panel/docs/entitlements-api.md.

# Base URL of the control-panel admin panel deployment
CONTROL_PANEL_API_URL=

# API key generated from the project's detail page in the control-panel
CONTROL_PANEL_API_KEY=

# Server-only: signing secret for the short-lived `cp_access` middleware
# cache cookie (HMAC-SHA256, see lib/signed-cookie.ts). Never prefix with
# NEXT_PUBLIC_. Generate with: openssl rand -hex 32
COOKIE_SIGNING_SECRET=
